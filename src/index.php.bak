    <script src="public/js/validaciones.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Modal de Historial Contextual
            const modalHistEl = document.getElementById('modalHistorialCentro');
            if (modalHistEl) {
                const bsModalHist = new bootstrap.Modal(modalHistEl);
                document.querySelectorAll('.btn-historial-centro').forEach(btn => {
                    btn.addEventListener('click', () => {
                        document.getElementById('modal-hist-codigo').textContent = btn.getAttribute('data-centro-codigo');
                        document.getElementById('modal-hist-nombre').textContent = btn.getAttribute('data-centro-nombre');
                        const tbody = document.getElementById('modal-hist-tbody');
                        tbody.innerHTML = '';
                        let logs = [];
                        try { logs = JSON.parse(btn.getAttribute('data-centro-logs') || '[]'); } catch (e) {}

                        if (logs.length === 0) {
                            document.getElementById('modal-hist-vacio').classList.remove('d-none');
                            document.getElementById('modal-hist-lista').classList.add('d-none');
                        } else {
                            document.getElementById('modal-hist-vacio').classList.add('d-none');
                            document.getElementById('modal-hist-lista').classList.remove('d-none');
                            logs.forEach(l => {
                                let badge = 'bg-secondary';
                                if (l.accion === 'CREAR_CENTRO') badge = 'bg-success';
                                else if (l.accion === 'EDITAR_CENTRO') badge = 'bg-primary';
                                else if (l.accion === 'DESACTIVAR_CENTRO') badge = 'bg-danger';
                                else if (l.accion === 'REACTIVAR_CENTRO') badge = 'bg-warning text-dark';

                                let det = {};
                                try { det = JSON.parse(l.detalles_json || '{}'); } catch (e) {}
                                let info = det.evento ? `<div class="fw-semibold text-primary small">${det.evento}</div>` : '';
                                if (det.campos_alterados) info += `<div class="text-muted small">Alterados: <code>${det.campos_alterados.join(', ')}</code></div>`;

                                const tr = document.createElement('tr');
                                tr.innerHTML = `
                                    <td class="code-tag">#${l.log_id}</td>
                                    <td class="small font-monospace">${l.fecha_hora}</td>
                                    <td class="small"><strong>${l.operador}</strong></td>
                                    <td><span class="badge ${badge}" style="font-size:0.70rem;">${l.accion}</span></td>
                                    <td class="font-monospace small">${l.ip_origen}</td>
                                    <td>${info || '<span class="text-muted small">Estándar</span>'}</td>
                                `;
                                tbody.appendChild(tr);
                            });
                        }
                        bsModalHist.show();
                    });
                });
            }

            // Modal de JSON Snapshot
            const modalJsonEl = document.getElementById('modalJson');
            if (modalJsonEl) {
                const bsModalJson = new bootstrap.Modal(modalJsonEl);
                document.querySelectorAll('.btn-ver-json').forEach(btn => {
                    btn.addEventListener('click', () => {
                        document.getElementById('modal-json-id').textContent = btn.getAttribute('data-log-id');
                        document.getElementById('modal-json-accion').textContent = btn.getAttribute('data-accion');
                        const raw = btn.getAttribute('data-json') || '{}';
                        try {
                            document.getElementById('modal-json-content').textContent = JSON.stringify(JSON.parse(raw), null, 2);
                        } catch (e) {
                            document.getElementById('modal-json-content').textContent = raw;
                        }
                        bsModalJson.show();
                    });
                });
            }
        });
    </script>

