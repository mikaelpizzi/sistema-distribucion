<?php
// src/index.php
// SICM | Panel Unificado de Gestión Asistencial, Parametrización 3FN y Trazabilidad Forense
declare(strict_types=1);

require_once __DIR__ . '/config/database.php';
$pdo = getDB();

$tabActiva    = $_GET['tab'] ?? 'centros';
$mensajeExito = $_GET['msg'] ?? null;
$mensajeError = $_GET['error'] ?? null;

// ============================================================================
// 1. DATOS PARA PESTAÑA: RED DE AMBULATORIOS
// ============================================================================
$filtroEstado = $_GET['estado'] ?? 'activos';
$busqueda     = trim($_GET['q'] ?? '');
$condiciones  = [];
$params       = [];

if ($filtroEstado === 'inactivos') {
    $condiciones[] = 'c.activo = 0';
} elseif ($filtroEstado === 'todos') {
    // Sin filtro
} else {
    $condiciones[] = 'c.activo = 1';
}

if ($busqueda !== '') {
    $condiciones[] = '(c.nombre LIKE :q1 OR c.codigo_sicm LIKE :q2 OR c.direccion LIKE :q3 OR c.medico_director LIKE :q4)';
    $params[':q1'] = '%' . $busqueda . '%';
    $params[':q2'] = '%' . $busqueda . '%';
    $params[':q3'] = '%' . $busqueda . '%';
    $params[':q4'] = '%' . $busqueda . '%';
}

$whereCentros = !empty($condiciones) ? 'WHERE ' . implode(' AND ', $condiciones) : '';
$sqlCentros = "SELECT c.id, c.codigo_sicm, c.nombre, c.tipo_centro_id, 
                      c.tipo_nombre, c.tipo_codigo,
                      c.medico_director, c.horario_atencion,
                      c.direccion, c.telefono_principal, c.activo, c.created_at, c.updated_at
               FROM vw_centros_salud c
               {$whereCentros}
               ORDER BY c.id DESC";
$stmtCentros = $pdo->prepare($sqlCentros);
$stmtCentros->execute($params);
$centros = $stmtCentros->fetchAll();

// Relación N:M de Recursos por Centro
$stmtRA = $pdo->query("SELECT cr.centro_salud_id, ro.id AS recurso_id, ro.codigo, ro.nombre, cr.detalle_capacidad
                       FROM centro_recursos cr
                       INNER JOIN recursos_operativos ro ON ro.id = cr.recurso_id
                       WHERE cr.operativo = 1 ORDER BY ro.id ASC");
$recursosPorCentro = [];
while ($row = $stmtRA->fetch()) {
    $recursosPorCentro[(int)$row['centro_salud_id']][] = $row;
}

// Catálogos para Formulario
$tiposCentro = $pdo->query("SELECT id, codigo, nombre FROM tipos_centro_salud ORDER BY id ASC")->fetchAll();
$catalogoRecursosActivos = $pdo->query("SELECT id, codigo, nombre, descripcion FROM recursos_operativos WHERE activo = 1 ORDER BY id ASC")->fetchAll();

// Edición de Centro
$centroEdicion = null;
$recursosEdicionIds = [];
$editarId = filter_input(INPUT_GET, 'editar', FILTER_VALIDATE_INT);
if ($editarId) {
    $stmtEd = $pdo->prepare("SELECT * FROM centros_salud WHERE id = :id");
    $stmtEd->execute([':id' => $editarId]);
    $centroEdicion = $stmtEd->fetch();
    if ($centroEdicion) {
        $stmtRecEd = $pdo->prepare("SELECT recurso_id FROM centro_recursos WHERE centro_salud_id = :id");
        $stmtRecEd->execute([':id' => $editarId]);
        $recursosEdicionIds = array_map('intval', $stmtRecEd->fetchAll(PDO::FETCH_COLUMN));
    }
}

// Logs Contextuales por Centro (Fila)
$logsPorCentro = [];
if (!empty($centros)) {
    $ids = implode(',', array_map('intval', array_column($centros, 'id')));
    $stmtCtx = $pdo->query("SELECT log_id, fecha_hora, operador, rol_operador, accion, registro_id, detalles_json, ip_origen
                            FROM vw_logs_auditoria
                            WHERE tabla_afectada = 'centros_salud' AND registro_id IN ({$ids})
                            ORDER BY log_id DESC");
    while ($l = $stmtCtx->fetch()) {
        $logsPorCentro[(int)$l['registro_id']][] = $l;
    }
}

// ============================================================================
// 2. DATOS PARA PESTAÑA: CATÁLOGOS MAESTROS (REGLA DE LOS 6 MESES)
// ============================================================================
$todosRecursos = $pdo->query("SELECT id, codigo, nombre, descripcion, activo FROM recursos_operativos ORDER BY id ASC")->fetchAll();

// ============================================================================
// 3. DATOS PARA PESTAÑA: BITÁCORA FORENSE
// ============================================================================
$filtroAccion = $_GET['accion_filtro'] ?? 'todas';
$busquedaLog  = trim($_GET['q_log'] ?? '');
$condLogs     = [];
$paramsLogs   = [];

if ($filtroAccion !== 'todas' && $filtroAccion !== '') {
    $condLogs[] = 'l.accion = :acc';
    $paramsLogs[':acc'] = $filtroAccion;
}
if ($busquedaLog !== '') {
    $condLogs[] = '(l.accion LIKE :ql1 OR l.tabla_afectada LIKE :ql2 OR l.ip_origen LIKE :ql3 OR l.operador LIKE :ql4 OR CAST(l.registro_id AS CHAR) = :ql5)';
    $paramsLogs[':ql1'] = '%' . $busquedaLog . '%';
    $paramsLogs[':ql2'] = '%' . $busquedaLog . '%';
    $paramsLogs[':ql3'] = '%' . $busquedaLog . '%';
    $paramsLogs[':ql4'] = '%' . $busquedaLog . '%';
    $paramsLogs[':ql5'] = $busquedaLog;
}
$whereLogs = !empty($condLogs) ? 'WHERE ' . implode(' AND ', $condLogs) : '';
$stmtLogs = $pdo->prepare("SELECT l.log_id, l.fecha_hora, l.usuario_id, l.operador, l.rol_operador, l.email_operador,
                                  l.accion, l.tabla_afectada, l.registro_id, l.ip_origen, l.detalles_json
                           FROM vw_logs_auditoria l
                           {$whereLogs}
                           ORDER BY l.log_id DESC LIMIT 50");
$stmtLogs->execute($paramsLogs);
$logs = $stmtLogs->fetchAll();

$accionesUnicas = $pdo->query("SELECT DISTINCT accion FROM logs_auditoria ORDER BY accion ASC")->fetchAll(PDO::FETCH_COLUMN);
$totalLogsCount = $pdo->query("SELECT COUNT(*) FROM logs_auditoria")->fetchColumn();
?>
